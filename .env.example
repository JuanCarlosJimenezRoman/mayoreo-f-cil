# Copiá este archivo como ".env" y completá con tus datos reales.
# Los obtenés al crear tu app en el panel de socios de Tiendanube:
# https://www.tiendanube.com/partners

CLIENT_ID=tu_client_id
CLIENT_SECRET=tu_client_secret

# URL pública donde vas a alojar este servidor (sin barra al final).
# Ej: https://mayoreo-baskatball23.up.railway.app
APP_URL=https://tu-servidor-publico.com

# Identifica tu app ante Tiendanube en cada request (obligatorio)
APP_USER_AGENT=Mayoreo BASKATBALL23 (tu-email@ejemplo.com)

PORT=3000

# Connection string de tu base PostgreSQL en Render
# (Internal Database URL si el server vive en el mismo proyecto de Render,
# External Database URL si te conectás desde otro lado)
DATABASE_URL=postgresql://usuario:password@host/nombre_db
